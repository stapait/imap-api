# Copy this file to .env (in this docker/ folder) to override the defaults.

# Password Dovecot will accept for IMAP login in local development.
# Note: Dovecot's default auth config accepts ANY username with this password —
# there's no enforced list of mailbox users. Use "testuser" (or any name you like)
# as the username when connecting.
DOVECOT_MAILBOX_PASSWORD=123
